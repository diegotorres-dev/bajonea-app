{
  "name": "bajonea-e2e",
  "version": "1.0.0",
  "description": "Testing E2E de Bajoneá (Fase 17) con Playwright + TypeScript",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:escritorio": "playwright test --project=escritorio",
    "test:webkit": "playwright test --config=playwright.webkit.config.ts",
    "test:reset": "node scripts/reset-db.mjs",
    "report": "playwright show-report",
    "verificar:conectividad": "node scripts/verificar-conectividad.mjs",
    "test:completa": "node scripts/verificar-conectividad.mjs && playwright test",
    "test:webkit:completa": "node scripts/verificar-conectividad.mjs && playwright test --config=playwright.webkit.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2"
  }
}
