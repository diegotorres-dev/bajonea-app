{
  "info": {
    "name": "Bajoneá MVP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección de testing de API para el backend del MVP de Bajoneá (Fase 14). Generada vía MCP de Postman por Claude Code. Carpetas numeradas 00-08 en el orden real de ejecución (dependencias reales: Administrador y Productos deben correr antes que Catálogo/Carrito/Pedidos), no en el orden de dominio literal de la guía — ver docs/DECISIONES.md."
  },
  "item": [
    {
      "name": "00 - Health",
      "id": "00-health-1",
      "item": [
        {
          "name": "Health check",
          "id": "health-check-2",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Status code es 200', () => pm.response.to.have.status(200));",
            "pm.test('La respuesta tiene mensaje', () => { const json = pm.response.json(); pm.expect(json.mensaje).to.exist; });"
          ]}}]
        }
      ]
    },
    {
      "name": "01 - Geografía",
      "id": "01-geografia-3",
      "item": [
        {
          "name": "Listar provincias",
          "id": "listar-provincias-4",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/geografia/provincias", "host": ["{{base_url}}"], "path": ["geografia", "provincias"] }
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Status code es 200', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.test('La respuesta tiene mensaje', () => pm.expect(json.mensaje).to.exist);",
            "const tdf = json.data.find(p => p.nombre.includes('Tierra del Fuego'));",
            "pm.test('Tierra del Fuego existe en el listado', () => pm.expect(tdf).to.exist);",
            "pm.environment.set('provincia_id', tdf.id);"
          ]}}]
        },
        {
          "name": "Listar localidades de Tierra del Fuego",
          "id": "listar-localidades-de-tierra-del-fuego-5",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/geografia/localidades?provinciaId={{provincia_id}}", "host": ["{{base_url}}"], "path": ["geografia", "localidades"], "query": [{"key": "provinciaId", "value": "{{provincia_id}}"}] }
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Status code es 200', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.test('La respuesta tiene mensaje', () => pm.expect(json.mensaje).to.exist);",
            "const rg = json.data.find(l => l.nombre.indexOf('Grande') !== -1);",
            "pm.test('Rio Grande existe en el listado', () => pm.expect(rg).to.exist);",
            "pm.environment.set('localidad_id', rg.id);"
          ]}}]
        },
        {
          "name": "[negativo] Listar localidades sin provinciaId",
          "id": "negativo-listar-localidades-sin-provinciaid-6",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/geografia/localidades", "host": ["{{base_url}}"], "path": ["geografia", "localidades"] }
          },
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('Status code es 400 (parametro requerido ausente)', () => pm.response.to.have.status(400));",
            "pm.test('La respuesta tiene mensaje', () => { const json = pm.response.json(); pm.expect(json.mensaje).to.exist; });"
          ]}}]
        }
      ]
    },
