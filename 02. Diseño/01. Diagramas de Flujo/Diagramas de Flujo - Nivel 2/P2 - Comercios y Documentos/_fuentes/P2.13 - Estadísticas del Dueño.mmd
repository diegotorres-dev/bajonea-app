flowchart TD
    A([Inicio]) --> B[/"El Dueño toca Ver estadísticas bajo las métricas del panel<br>(solo en contexto Dueño: el Empleado y el Administrador reciben 403)"/]
    B --> C["comercio-estadisticas.html: exigirDueno<br>Chips 7 días y 30 días (por defecto 30)<br>hasta = hoy en zona America/Argentina/Ushuaia<br>desde = hoy menos 6 días o menos 29 días: hoy incluido, ambos extremos inclusive"]
    C --> D["Esqueleto de carga: dos GET en paralelo<br>GET /api/v1/comercios/estadisticas con desde, hasta y agrupar = DIA<br>GET /api/v1/comercios/estadisticas con desde, hasta y agrupar = TURNO<br>Header X-Comercio-Id obligatorio, respuestas cacheadas por rango"]
    D --> E{"¿X-Comercio-Id presente, numérico y del Dueño?"}
    E -- "Ausente, vacío o no numérico" --> E1[/"HTTP 400"/]
    E -- "Ajeno o inexistente" --> E2[/"HTTP 404 COMERCIO_NO_DISPONIBLE"/]
    E1 --> ERR
    E2 --> ERR
    E -- Sí --> F{"¿Fechas presentes?"}
    F -- No --> F1[/"HTTP 400: Indicá las fechas desde y hasta"/]
    F -- Sí --> G{"¿Formato AAAA-MM-DD?"}
    G -- No --> G1[/"HTTP 400: La fecha desde tiene que tener el formato AAAA-MM-DD / La fecha hasta tiene que tener el formato AAAA-MM-DD"/]
    G -- Sí --> H{"¿Desde es posterior a hasta?"}
    H -- Sí --> H1[/"HTTP 400: La fecha desde no puede ser posterior a la fecha hasta"/]
    H -- No --> I{"¿El rango supera 92 días?"}
    I -- Sí --> I1[/"HTTP 400: El rango no puede superar los 92 días"/]
    I -- No --> J{"¿agrupar es DIA o TURNO?"}
    J -- No --> J1[/"HTTP 400: La agrupación tiene que ser DIA o TURNO"/]
    F1 --> ERR
    G1 --> ERR
    H1 --> ERR
    I1 --> ERR
    J1 --> ERR
    J -- Sí --> K
    subgraph TX ["Transacción BD de solo lectura, sin bloqueos y sin mirar el estado del comercio"]
        K["SELECT pedido: turno_fecha, turno_horario_id, estado, COUNT, SUM(subtotal), SUM(cargo_servicio_comercio)<br>WHERE comercio_id = (id) AND turno_fecha BETWEEN desde y hasta GROUP BY turno_fecha, turno_horario_id, estado"] --> L["SELECT pedido WHERE turno_fecha IS NULL AND fecha_pago_confirmado dentro del rango GROUP BY DATE(fecha_pago_confirmado), estado<br>Un pedido nunca pagado no aparece"]
        L --> M["Arma las cifras: pedidos = todas las filas<br>facturados, vendido y comisión: solo EN_PREPARACION, EN_CAMINO, LISTO_PARA_RETIRAR, ENTREGADO y NO_RETIRADO<br>neto = vendido menos comisión, ticketPromedio = vendido dividido facturados (nulo si no hay facturados)<br>Resultados en 7 categorías: ENTREGADO, NO_RETIRADO, RECHAZADO, CANCELADO (incluye cancelado por sistema), ANULADO, EXPIRADO y EN_CURSO"]
        M --> N{"¿Agrupación?"}
        N -- DIA --> N1["Una entrada por cada día del rango, con ceros en los vacíos<br>Cada pedido cuenta en el día en que abrió su turno, los pagados sin turno en el día de pago"]
        N -- TURNO --> N2["Solo turnos con pedidos, ordenados por fecha e inicio, con inicio, fin y cruzaMedianoche<br>Las entradas sin turno van al final de cada día"]
    end
    N1 --> O[/"HTTP 200: Estadísticas obtenidas correctamente<br>desde, hasta, agrupar, totales y periodos"/]
    N2 --> O
    O --> P{"¿Hay pedidos en el rango?"}
    P -- No --> P1[/"No hubo pedidos en los últimos N días.<br>Solo en 7 días y si los 30 días tienen pedidos: botón Ver los últimos 30 días"/]
    P1 --> FIN1([Fin])
    P -- Sí --> Q[/"Cuatro tiles: Vendido, Comisión, Neto y Ticket promedio (con guion si no hay dato)<br>Vendido por día: barras navegables con flechas, Inicio y Fin. Cada pedido cuenta en el día en que abrió su turno.<br>Al tocar una barra: día, Vendido, N pedidos y turnos con rango HH:MM a HH:MM (día siguiente si cruza medianoche) o Sin turno asignado<br>Cómo terminaron los pedidos: Entregados, No retirados, Rechazados, Cancelados, Anulados, Sin respuesta y En curso"/]
    Q --> R{"¿Elige otro rango?"}
    R -- Sí --> D
    R -- No --> FIN2([Fin])
    ERR["Error de carga"] --> ERR1[/"No pudimos cargar las estadísticas. Probá de nuevo.<br>Botón: Reintentar. Una consulta fallida se descarta de la caché"/]
    ERR1 --> FIN3([Fin])
    Q -.-> S["No es una foto: refleja el estado actual de los pedidos y puede diferir del email de cierre de turno (ver P7.05)"]
