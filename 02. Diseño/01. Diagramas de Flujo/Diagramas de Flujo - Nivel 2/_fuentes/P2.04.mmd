        N -- APTO_VENTA --> N4{"¿Puede seguir?<br>Mercado Pago activo Y (documentación no exigida<br>O al menos 1 aprobado)"}
        N4 -- No --> N5["UPDATE comercio: APROBADO<br>INSERT historial_estado_comercio (sin administrador)<br>El comercio sale del catálogo y no acepta pedidos nuevos"]
        N4 -- Sí --> N6["Sigue APTO_VENTA<br>(CERRADO_TEMPORALMENTE si el Dueño está bloqueado)"]
        N -- "SUSPENDIDO, CERRADO_TEMPORALMENTE,<br>INACTIVO, PENDIENTE, RECHAZADO" --> N7["No se mueve en este flujo"]
