    subgraph TX [Transacción BD]
        I["SELECT usuario y cuenta_mercado_pago del Dueño (FOR UPDATE)<br>SELECT comercio (FOR UPDATE)<br>SELECT documento (FOR UPDATE)"] --> J{"¿Estado actual del documento<br>y acción pedida?"}
        J -- "Aprobar y está PENDIENTE" --> K1["UPDATE documento: estado = APROBADO, motivo_rechazo = NULL"]
