    AG1 -- Sí --> AG3
    subgraph TX1 [Transacción BD - agregar al carrito]
        AG3["SELECT producto (LOCK IN SHARE MODE), antes de bloquear el carrito"] --> AG4{"¿Existe y está DISPONIBLE?"}
