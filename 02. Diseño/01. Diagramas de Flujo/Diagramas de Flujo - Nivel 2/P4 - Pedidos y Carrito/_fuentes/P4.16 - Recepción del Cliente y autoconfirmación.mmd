    E1 --> FIN7([Fin])
    R6 --> R7[/"HTTP 200: Entrega confirmada correctamente<br>Toast: Entrega confirmada<br>El detalle muestra Entregado y, si corresponde, la opción de reclamar (ver P4.08)"/]
    R7 --> FIN6([Fin])

    J0 --> J1
    subgraph TXJ [Transacción BD - por cada pedido EN_CAMINO]
        J1["Bloqueos: usuarios del Cliente, del Dueño y candidatos a equipo, relaciones, pedido (FOR UPDATE)<br>Revalida estado EN_CAMINO"] --> J2["SELECT última fila EN_CAMINO de historial_estado_pedido<br>minutos = ahora menos esa hora"]
