        J4 -- No --> J6{"¿Minutos mayor o igual a 75 y primer aviso sin emitir?<br>(aviso-en-camino-minutos)"}
        J6 -- Sí --> J7["UPDATE pedido: primer_aviso_emitido = verdadero<br>INSERT aviso al Cliente AVISO_75MIN_SIN_CONFIRMACION:<br>Tu pedido número sigue en camino. Si ya lo recibiste, confirmalo para cerrarlo.<br>(una sola vez; sin aviso al comercio; sin email)"]
