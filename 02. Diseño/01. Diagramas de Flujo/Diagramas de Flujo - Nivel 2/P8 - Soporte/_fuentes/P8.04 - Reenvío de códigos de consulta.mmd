    subgraph TX ["Transacción BD - reenvío de códigos"]
        E["INSERT soporte_limite REENVIO_EMAIL y después REENVIO_IP, SELECT FOR UPDATE de cada fila"] --> F{"¿El contador del email o el de la IP ya llegó a 3 en la ventana de 60 minutos?"}
        F -- Sí --> F1["Error de límite"]
        F -- No --> G["UPDATE soporte_limite: cantidad + 1 en REENVIO_EMAIL y REENVIO_IP<br>Siempre, existan o no consultas"]
        G --> H["SELECT ticket_soporte WHERE email = (email) AND estado distinto de CERRADO ORDER BY id"]
