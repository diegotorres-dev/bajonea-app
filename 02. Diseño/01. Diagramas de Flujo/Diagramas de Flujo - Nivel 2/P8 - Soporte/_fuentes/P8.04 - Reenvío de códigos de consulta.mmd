flowchart TD
    A([Inicio]) --> B[/"El Visitante toca ¿Perdiste el código? en soporte-consulta.html<br>Escribe Tu email y toca Reenviar código"/]
    B --> C["POST /api/v1/soporte/publico/codigos/reenviar con email (público, sin JWT)"]
    C --> D{"¿Pasa la validación del email?"}
    D -- No --> D1[/"HTTP 400: El email es obligatorio / Ingresá un email válido / El email no puede superar los 254 caracteres"/]
    D1 --> D2["La pantalla muestra el error<br>Por defecto: No pudimos reenviar el código. Probá de nuevo."]
    D2 --> FIN1([Fin])
